# Copy this file to `.env` and adjust values. Never commit `.env`.

# Local development
DJANGO_DEBUG=true

# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Comma-separated hosts allowed to serve the site
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app

# --- Vercel (set in the Vercel project dashboard, not in this file) ---
# SECRET_KEY=<random>
# DJANGO_DEBUG=false
# ALLOWED_HOSTS=yourdomain.com,.vercel.app
